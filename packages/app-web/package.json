{
	"name": "@joplin/app-web",
	"private": true,
	"version": "0.1.0",
	"description": "Thin-client web frontend skeleton for Joplin Server",
	"main": "server.js",
	"dependencies": {
		"pg": "8.16.3"
	},
	"scripts": {
		"start": "node server.js",
		"test": "node --test tests/*.test.js",
		"generate:pwa-assets": "node ./scripts/generatePwaAssets.mjs",
		"deploy:docker": "docker compose -f ../../docker-compose.app-web.yml --env-file ../../.env.app-web up -d --build --no-deps app-web"
	},
	"devDependencies": {
		"sharp": "^0.34.5"
	}
}
